# ==============================================================================
# AIRGRID ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==============================================================================
# IMPORTANT: Copy this file to .env and adjust values for your local environment.
# Never commit the .env file containing real secrets to version control.
# ==============================================================================

# Core System
AIRGRID_ENV=development
AIRGRID_DEBUG=true
AIRGRID_SECRET_KEY=change-this-in-production-use-a-minimum-32-char-random-key
AIRGRID_API_HOST=127.0.0.1
AIRGRID_API_PORT=8000
AIRGRID_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Database (PostgreSQL)
# Note: For isolated local unit testing without Docker, SQLite fallback is supported
AIRGRID_DB_HOST=127.0.0.1
AIRGRID_DB_PORT=5432
AIRGRID_DB_USER=airgrid
AIRGRID_DB_PASSWORD=airgrid_local_dev_secret
AIRGRID_DB_NAME=airgrid_db
DATABASE_URL=postgresql+asyncpg://airgrid:airgrid_local_dev_secret@127.0.0.1:5432/airgrid_db
DATABASE_URL_SYNC=postgresql://airgrid:airgrid_local_dev_secret@127.0.0.1:5432/airgrid_db

# Web Frontend
VITE_API_BASE_URL=http://127.0.0.1:8000
AIRGRID_WEB_PORT=5173

# AI Gateway (Server-Side Only)
# Pluggable OpenAI-compatible endpoint (Ollama, vLLM, Groq, Together, DeepSeek)
AIRGRID_AI_ENABLED=true
AIRGRID_AI_PROVIDER=openai_compatible
AIRGRID_AI_API_BASE_URL=https://api.groq.com/openai/v1
AIRGRID_AI_API_KEY=
AIRGRID_AI_DEFAULT_MODEL=llama-3.3-70b-versatile
AIRGRID_AI_TIMEOUT_SECONDS=30
AIRGRID_AI_TEMPERATURE=0.2

# n8n Automation & Webhook Integration
# Default port set to 5680 to avoid collisions with other local containers
AIRGRID_N8N_PORT=5680
AIRGRID_N8N_WEBHOOK_URL=http://127.0.0.1:5680/webhook/airgrid-events
AIRGRID_WEBHOOK_SECRET=airgrid-webhook-hmac-secret-key-32chars
AIRGRID_WEBHOOK_TIMEOUT_SECONDS=10

# Network Testing & Measurement Guardrails
AIRGRID_SPEEDTEST_DURATION_SECONDS=10
AIRGRID_SPEEDTEST_MAX_MB=150
AIRGRID_AUTHORIZED_IPERF_TARGETS=127.0.0.1,10.0.0.1
