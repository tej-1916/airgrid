# Isolated verification image for the "lab" compose profile. Not used by the normal api/web services.
# Contains the API source, tests and pinned dependencies (uv.lock). Runs as a non-root user on a read-only root filesystem.
FROM python:3.13-slim AS build
ENV UV_COMPILE_BYTECODE=0 UV_LINK_MODE=copy
COPY --from=ghcr.io/astral-sh/uv:0.13.8 /uv /bin/uv
WORKDIR /app
COPY pyproject.toml uv.lock README.md ./
RUN uv sync --frozen --all-extras --no-install-project

FROM python:3.13-slim
RUN useradd --uid 10001 --no-create-home --shell /usr/sbin/nologin lab
WORKDIR /app
COPY --from=build /app/.venv /app/.venv
COPY pyproject.toml README.md alembic.ini ./
COPY src ./src
COPY migrations ./migrations
COPY tests ./tests
ENV PATH=/app/.venv/bin:$PATH PYTHONPATH=/app/src PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
USER 10001:10001
CMD ["python", "-m", "pytest", "-p", "no:cacheprovider", "-o", "addopts=", "-q", "tests/test_lab_isolation.py"]
